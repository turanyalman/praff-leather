@model ChangePasswordForm
<div class="acc">
    <div class="aw">
        <partial name="_Side" />
        <div>
            <h1>Şifre Değiştir</h1>
            <p class="sub">Yeni şifreniz en az 8 karakter olmalı, harf ve rakam içermelidir.</p>
            <form class="box" method="post" action="/hesap/sifre" asp-antiforgery="true" novalidate style="display:grid;gap:16px;max-width:520px">
                <div class="val-sum" asp-validation-summary="ModelOnly"></div>
                <label class="field">Mevcut Şifre<input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><span class="err" asp-validation-for="CurrentPassword"></span></label>
                <label class="field">Yeni Şifre<input asp-for="NewPassword" type="password" autocomplete="new-password" /><span class="err" asp-validation-for="NewPassword"></span></label>
                <label class="field">Yeni Şifre (Tekrar)<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span class="err" asp-validation-for="ConfirmPassword"></span></label>
                <div><button class="btn btn-gold" type="submit">Şifreyi Değiştir</button></div>
            </form>
        </div>
    </div>
</div>
