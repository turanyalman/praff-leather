<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <httpErrors existingResponse="PassThrough" />
      <!-- processPath="dotnet": taşınabilir paket, Turhost'un 32-bit uygulama havuzunda çalışır.
           İlk kurulumda stdout günlüğü açık; site sorunsuz çalışınca stdoutLogEnabled="false" yapın. -->
      <aspNetCore processPath="dotnet" arguments=".\PraffLeather.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Ürün görseli yükleme: istek başına en fazla 30 MB -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
